# Required for durable account storage and signed private sessions.
DATABASE_URL=
AUTH_SECRET=
# Gmail sending: use a Google App Password, never your regular Gmail password.
SMTP_USER=
SMTP_PASSWORD=
# Optional alternative: Resend API and a verified sender.
RESEND_API_KEY=
MAIL_FROM=
# Optional Google sign-in stays hidden by default.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
