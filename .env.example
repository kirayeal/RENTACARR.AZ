# Google Cloud Console: Web OAuth Client ID. Add your exact Vercel origin to Authorized JavaScript Origins.
GOOGLE_CLIENT_ID=
# Random private signing key, at least 32 characters. Never expose through a VITE_ variable.
AUTH_SECRET=
# Neon Postgres connection URL. Set securely in Vercel Environment Variables.
DATABASE_URL=
# Google stays hidden unless explicitly enabled.
GOOGLE_LOGIN_ENABLED=false
# Phone sign-in: Twilio Verify. Credentials are private, server-only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
